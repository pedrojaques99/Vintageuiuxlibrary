{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "vintage-base",
  "title": "Vintage Base",
  "author": "Visant Labs <visantsupply@gmail.com>",
  "description": "A fundação do kit: variáveis de painel, texturas e as regras em @layer.",
  "registryDependencies": [
    "@visant/vintage-theme"
  ],
  "cssVars": {
    "theme": {
      "font-vintage-display": "'Orbitron', sans-serif",
      "font-vintage-mono": "'Red Hat Mono', monospace",
      "font-vintage-body": "'Helvetica Neue', Helvetica, sans-serif",
      "radius": "0.5rem"
    },
    "light": {
      "background": "#0f0f0f",
      "foreground": "#e8e8e8",
      "primary": "#ffd700",
      "primary-foreground": "#0f0f0f",
      "radius": "0.5rem"
    },
    "dark": {
      "background": "#0f0f0f",
      "foreground": "#e8e8e8",
      "primary": "#ffd700",
      "primary-foreground": "#0f0f0f"
    }
  },
  "css": {
    "@import \"https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&family=Red+Hat+Mono:wght@400;500;600;700&display=swap\"": {}
  },
  "type": "registry:base"
}