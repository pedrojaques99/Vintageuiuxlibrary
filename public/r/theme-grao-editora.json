{
  "$schema": "https://ui.shadcn.com/schema/registry-item.json",
  "name": "theme-grao-editora",
  "type": "registry:theme",
  "title": "Grão Editora — brand theme",
  "author": "Visant Labs <visantsupply@gmail.com>",
  "description": "Tokens gerados de brand guideline demo-grao-editora v1. Contraste AA garantido por construção. Não editar à mão — regenerar.",
  "cssVars": {
    "theme": {
      "font-sans": "'Karla', ui-sans-serif, system-ui, sans-serif",
      "font-display": "'Fraunces', ui-sans-serif, system-ui, sans-serif",
      "r-control": "0.5rem",
      "r-surface": "0.875rem",
      "r-pill": "9999px",
      "e-flat": "none",
      "e-raised": "0 1px 2px hsl(var(--shadow) / 0.06), 0 6px 16px hsl(var(--shadow) / 0.10)",
      "e-overlay": "0 2px 6px hsl(var(--shadow) / 0.12), 0 12px 32px hsl(var(--shadow) / 0.14)",
      "e-modal": "0 8px 40px hsl(var(--shadow) / 0.22)",
      "focus": "0 0 0 2px var(--background), 0 0 0 4px var(--brand)",
      "ease-out": "cubic-bezier(0.23, 1, 0.32, 1)",
      "ease-in-out": "cubic-bezier(0.77, 0, 0.175, 1)",
      "ease-drawer": "cubic-bezier(0.32, 0.72, 0, 1)",
      "dur-press": "120ms",
      "dur-fast": "160ms",
      "dur-base": "200ms",
      "dur-slow": "300ms",
      "pad-card": "1.25rem",
      "control-h": "2.25rem",
      "gap-zone": "1rem"
