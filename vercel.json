{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/r/(.*).json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/r/(.*).md",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/markdown; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/llms.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/og/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=604800, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mcp",
      "destination": "/api/mcp"
    },
    {
      "source": "/((?!r/|og/|assets/|api/|mcp|llms.txt).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/kit/marca-viva",
      "destination": "/kit/brand-system",
      "permanent": true
    },
    {
      "source": "/catalogo/aquisicao",
      "destination": "/catalogo/secoes",
      "permanent": true
    },
    {
      "source": "/catalogo/trabalho",
      "destination": "/catalogo/controles",
      "permanent": true
    },
    {
      "source": "/catalogo/motion",
      "destination": "/catalogo/efeitos",
      "permanent": true
    },
    {
      "source": "/catalogo/marca",
      "destination": "/catalogo/fundacao",
      "permanent": true
    },
    {
      "source": "/catalogo/base",
      "destination": "/catalogo/fundacao",
      "permanent": true
    },
    {
      "source": "/catalogo/cards",
      "destination": "/catalogo/conteudo",
      "permanent": true
    },
    {
      "source": "/catalogo/midia",
      "destination": "/catalogo/conteudo",
      "permanent": true
    },
    {
      "source": "/catalogo/3d",
      "destination": "/catalogo/conteudo",
      "permanent": true
    },
    {
      "source": "/catalogo/shaders",
      "destination": "/catalogo/efeitos",
      "permanent": true
    },
    {
      "source": "/catalogo/texturas",
      "destination": "/catalogo/efeitos",
      "permanent": true
    },
    {
      "source": "/catalogo/vintage",
      "destination": "/catalogo/controles",
      "permanent": true
    },
    {
      "source": "/catalogo/didatica",
      "destination": "/catalogo/anatomia",
      "permanent": true
    }
  ]
}
